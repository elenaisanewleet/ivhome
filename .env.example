NODE_ENV=development
HOST=0.0.0.0
PORT=3000

POSTGRES_DB=ivhome
POSTGRES_USER=ivhome
POSTGRES_PASSWORD=ivhome_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ivhome:ivhome_local_password@localhost:5432/ivhome?schema=public

