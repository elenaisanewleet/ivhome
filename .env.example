NODE_ENV=development
HOST=0.0.0.0
PORT=3000

POSTGRES_DB=ivhome
POSTGRES_USER=ivhome
POSTGRES_PASSWORD=ivhome_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ivhome:ivhome_local_password@localhost:5432/ivhome?schema=public

# Added in PR 3. Keep secrets out of source control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=http://localhost:5173

# Mini App/API integration. For a controlled Replit preview, manually set ENABLE_MVP_DEV_API=true.
ENABLE_MVP_DEV_API=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPPORT_URL=

# Added with staff login. Replace with a long random value outside local development.
STAFF_SESSION_SECRET=change_me_before_use
