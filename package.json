{
  "name": "ivhome",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @ivhome/shared build && pnpm --parallel --stream --filter @ivhome/api --filter @ivhome/mini-app --filter @ivhome/telegram-bot --filter @ivhome/dashboard dev",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && pnpm -r --if-present typecheck && tsc --noEmit -p prisma/tsconfig.json",
    "build": "pnpm -r --if-present build",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://ivhome:ivhome_local_password@127.0.0.1:5432/ivhome?schema=public} prisma validate --schema prisma/schema.prisma",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://ivhome:ivhome_local_password@127.0.0.1:5432/ivhome?schema=public} prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
