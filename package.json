{
  "name": "ivhome",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @ivhome/shared build && pnpm --parallel --stream --filter @ivhome/api --filter @ivhome/mini-app --filter @ivhome/telegram-bot --filter @ivhome/dashboard dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "prisma": "^6.8.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
