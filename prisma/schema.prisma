generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETION_REQUESTED
  DELETED
}

enum PlatformRole {
  PATIENT
  PLATFORM_SUPPORT
  PLATFORM_MODERATOR
  PLATFORM_ADMIN
  PLATFORM_SECURITY_AUDITOR
}

enum ClinicRole {
  CLINIC_OPERATOR
  CLINIC_AUTHORIZED_STAFF
  CLINIC_ADMIN
}

enum ClinicStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum LicenseStatus {
  PENDING
  VERIFIED
  EXPIRED
  SUSPENDED
  REVOKED
  REJECTED
  RECHECK_REQUIRED
}

enum ServiceRequestStatus {
  DRAFT
  SCREENING_BLOCKED
  SUBMITTED
  SENT_TO_CLINIC
  CLINIC_REVIEW
  CLARIFICATION_REQUIRED
  QUOTE_PROVIDED
  DECLINED_BY_CLINIC
  CANCELLED_BY_PATIENT
  EXPIRED
  BOOKED
}

enum QuoteStatus {
  DRAFT
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum BookingStatus {
  CONFIRMED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  SERVICE_STARTED
  COMPLETED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_CLINIC
  FAILED
  NO_SHOW
}

enum ScreeningOutcome {
  PASSED
  BLOCKED_EMERGENCY
}

enum ConsentType {
  PERSONAL_DATA_PROCESSING
  HEALTH_DATA_PROCESSING
  PARTNER_DATA_TRANSFER
  TERMS_OF_USE
  PRIVACY_POLICY_ACKNOWLEDGEMENT
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  CONSENT_ACCEPT
  CONSENT_REVOKE
  EXPORT
  ROLE_ASSIGN
  ROLE_REVOKE
  LICENSE_VERIFY
  LICENSE_SUSPEND
  SCREENING_BLOCK
  QUOTE_FIX
  QUOTE_REPLACE
  BOOKING_STATUS_CHANGE
  PARTNER_LEAD_SEND
  PARTNER_LEAD_STATUS_CHANGE
  MVP_CLINIC_CREATE
  MVP_CLINIC_UPDATE
  MVP_CLINIC_ACCESS_TOKEN_CREATE
  MVP_CLINIC_ACCESS_TOKEN_REVOKE
  MVP_CLINIC_ACCESS_TOKEN_USE
  MVP_REQUEST_LIST_VIEW
  MVP_REQUEST_STATUS_UPDATE
  MVP_CHAT_MESSAGE_SEND
  MVP_ONBOARDING_SAVE
  MVP_ONBOARDING_SUBMIT
}

enum AuditActorType {
  USER
  CLINIC_MEMBER
  PLATFORM_STAFF
  SYSTEM
}

enum SlaMetricType {
  CLINIC_FIRST_RESPONSE
  CLINIC_CONFIRMATION
  ARRIVAL
  COMPLETION
}

enum SlaEventStatus {
  PENDING
  MET
  BREACHED
  CANCELLED
}

enum PartnerContactChannelType {
  TELEGRAM
  WHATSAPP
  PHONE
  EMAIL
  DASHBOARD
}

enum PartnerLeadStatus {
  CREATED
  SENT_TO_PARTNER
  ACCEPTED_BY_PARTNER
  REJECTED_BY_PARTNER
  CONVERTED_TO_BOOKING
  EXPIRED
  CANCELLED
}

enum LeadBillingStatus {
  NOT_BILLABLE
  PENDING
  BILLABLE
  INVOICED
  PAID
  WAIVED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RatingModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model User {
  id             String     @id @default(cuid())
  status         UserStatus @default(ACTIVE)
  displayName    String?
  phoneEncrypted String?
  emailEncrypted String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  telegramIdentity    TelegramIdentity?
  platformMemberships PlatformMembership[]
  clinicMemberships   ClinicMembership[]
  checkedLicenses     ClinicLicense[]      @relation("ClinicLicenseCheckedBy")
  consentAcceptances  ConsentAcceptance[]
  screenings          EmergencyScreening[]
  requests            ServiceRequest[]
  ratings             Rating[]
}

model TelegramIdentity {
  id             String   @id @default(cuid())
  userId         String   @unique
  telegramUserId BigInt   @unique
  username       String?
  languageCode   String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformMembership {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  createdAt DateTime     @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, role])
}

model Clinic {
  id            String       @id @default(cuid())
  legalName     String
  publicName    String
  inn           String       @unique
  ogrn          String?
  status        ClinicStatus @default(DRAFT)
  ratingAverage Decimal?     @db.Decimal(3, 2)
  ratingCount   Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships     ClinicMembership[]
  licenses        ClinicLicense[]
  serviceOffers   ClinicServiceOffer[]
  serviceAreas    ClinicServiceArea[]
  contactChannels PartnerContactChannel[]
  partnerLeads    PartnerLead[]
  requests        ServiceRequest[]
  quotes          Quote[]
  bookings        Booking[]
  ratings         Rating[]
  mvpRequests      MvpRequest[]
  mvpOnboarding    MvpOnboarding?
  mvpAccessTokens  MvpClinicAccessToken[]

  @@index([status])
}

model ClinicMembership {
  id        String     @id @default(cuid())
  clinicId  String
  userId    String
  role      ClinicRole
  createdAt DateTime   @default(now())
  revokedAt DateTime?

  clinic          Clinic  @relation(fields: [clinicId], references: [id])
  user            User    @relation(fields: [userId], references: [id])
  confirmedQuotes Quote[] @relation("QuoteConfirmedByMember")

  @@index([clinicId, role])
  @@index([userId])
}

model ClinicLicense {
  id                 String        @id @default(cuid())
  clinicId           String
  licenseNumber      String
  issuedAt           DateTime?
  expiresAt          DateTime?
  authorityName      String?
  registryUrl        String?
  registryRecordId   String?
  licensedActivities Json
  licensedAddresses  Json
  status             LicenseStatus @default(PENDING)
  checkedAt          DateTime?
  nextCheckAt        DateTime?
  checkedByUserId    String?
  verificationNotes  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  clinic    Clinic @relation(fields: [clinicId], references: [id])
  checkedBy User?  @relation("ClinicLicenseCheckedBy", fields: [checkedByUserId], references: [id])

  @@unique([clinicId, licenseNumber])
  @@index([clinicId, status])
  @@index([licenseNumber])
  @@index([nextCheckAt])
}

model ServiceCategory {
  id                String   @id @default(cuid())
  slug              String   @unique
  publicName        String
  publicDescription String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  offers   ClinicServiceOffer[]
  requests ServiceRequest[]
}

model ClinicServiceOffer {
  id                   String      @id @default(cuid())
  clinicId             String
  serviceCategoryId    String
  status               OfferStatus @default(DRAFT)
  preliminaryPriceFrom Decimal?    @db.Decimal(12, 2)
  preliminaryPriceTo   Decimal?    @db.Decimal(12, 2)
  currency             String      @default("RUB")
  etaMinutesFrom       Int?
  etaMinutesTo         Int?
  cancellationTerms    String?
  publicConditions     String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  clinic          Clinic          @relation(fields: [clinicId], references: [id])
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id])

  @@unique([clinicId, serviceCategoryId])
  @@index([status])
  @@index([serviceCategoryId, status])
}

model ClinicServiceArea {
  id           String  @id @default(cuid())
  clinicId     String
  districtCode String
  districtName String
  isActive     Boolean @default(true)

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, districtCode])
  @@index([districtCode, isActive])
}

model PartnerContactChannel {
  id             String                    @id @default(cuid())
  clinicId       String
  type           PartnerContactChannelType
  label          String
  valueEncrypted String?
  valueMasked    String?
  isPrimary      Boolean                   @default(false)
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  partnerLeads PartnerLead[]

  @@index([clinicId, type])
}

model PartnerLead {
  id               String            @id @default(cuid())
  requestId        String?
  clinicId         String
  status           PartnerLeadStatus @default(CREATED)
  billingStatus    LeadBillingStatus @default(NOT_BILLABLE)
  contactChannelId String?
  sentAt           DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  convertedAt      DateTime?
  leadFeeAmount    Decimal?          @db.Decimal(12, 2)
  commissionRate   Decimal?          @db.Decimal(5, 2)
  currency         String            @default("RUB")
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  request        ServiceRequest?        @relation(fields: [requestId], references: [id])
  clinic         Clinic                 @relation(fields: [clinicId], references: [id])
  contactChannel PartnerContactChannel? @relation(fields: [contactChannelId], references: [id])

  @@index([clinicId, status])
  @@index([requestId])
}

model ConsentDocument {
  id          String      @id @default(cuid())
  type        ConsentType
  version     String
  title       String
  contentHash String
  documentUrl String
  publishedAt DateTime
  revokedAt   DateTime?

  acceptances ConsentAcceptance[]

  @@unique([type, version])
}

model ConsentAcceptance {
  id                String    @id @default(cuid())
  userId            String
  consentDocumentId String
  acceptedAt        DateTime  @default(now())
  revokedAt         DateTime?
  ipHash            String?
  userAgentHash     String?
  telegramUserId    BigInt?
  evidence          Json?

  user            User            @relation(fields: [userId], references: [id])
  consentDocument ConsentDocument @relation(fields: [consentDocumentId], references: [id])

  @@index([userId, acceptedAt])
}

model EmergencyScreening {
  id            String           @id @default(cuid())
  userId        String
  schemaVersion String
  answers       Json
  outcome       ScreeningOutcome
  blockedReason String?
  completedAt   DateTime         @default(now())

  user    User            @relation(fields: [userId], references: [id])
  request ServiceRequest?

  @@index([userId, completedAt])
}

model ServiceRequest {
  id                      String               @id @default(cuid())
  userId                  String
  clinicId                String?
  serviceCategoryId       String
  emergencyScreeningId    String               @unique
  status                  ServiceRequestStatus @default(DRAFT)
  districtCode            String
  addressEncrypted        String?
  addressCommentEncrypted String?
  requestedWindowFrom     DateTime
  requestedWindowTo       DateTime
  patientCommentEncrypted String?
  submittedAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  user               User                   @relation(fields: [userId], references: [id])
  clinic             Clinic?                @relation(fields: [clinicId], references: [id])
  serviceCategory    ServiceCategory        @relation(fields: [serviceCategoryId], references: [id])
  emergencyScreening EmergencyScreening     @relation(fields: [emergencyScreeningId], references: [id])
  quotes             Quote[]
  booking            Booking?
  statusHistory      RequestStatusHistory[]
  partnerLeads       PartnerLead[]

  @@index([userId, createdAt])
  @@index([clinicId, status])
}

model RequestStatusHistory {
  id         String                @id @default(cuid())
  requestId  String
  fromStatus ServiceRequestStatus?
  toStatus   ServiceRequestStatus
  reason     String?
  actorType  AuditActorType
  actorId    String?
  createdAt  DateTime              @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id])

  @@index([requestId, createdAt])
}

model Quote {
  id                            String      @id @default(cuid())
  requestId                     String
  clinicId                      String
  version                       Int
  status                        QuoteStatus @default(DRAFT)
  fixedPrice                    Decimal     @db.Decimal(12, 2)
  currency                      String      @default("RUB")
  priceBreakdown                Json?
  confirmedEtaAt                DateTime
  validUntil                    DateTime
  cancellationTerms             String?
  conditionsSnapshot            Json
  medicalFeasibilityConfirmedAt DateTime
  confirmedByMemberId           String
  replacementReason             String?
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime    @updatedAt

  request           ServiceRequest   @relation(fields: [requestId], references: [id])
  clinic            Clinic           @relation(fields: [clinicId], references: [id])
  confirmedByMember ClinicMembership @relation("QuoteConfirmedByMember", fields: [confirmedByMemberId], references: [id])
  booking           Booking?

  @@unique([requestId, version])
  @@index([clinicId, status])
}

model Booking {
  id                 String        @id @default(cuid())
  requestId          String        @unique
  quoteId            String        @unique
  clinicId           String
  status             BookingStatus @default(CONFIRMED)
  confirmedAt        DateTime      @default(now())
  assignedAt         DateTime?
  enRouteAt          DateTime?
  arrivedAt          DateTime?
  serviceStartedAt   DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  request   ServiceRequest @relation(fields: [requestId], references: [id])
  quote     Quote          @relation(fields: [quoteId], references: [id])
  clinic    Clinic         @relation(fields: [clinicId], references: [id])
  slaEvents SlaEvent[]
  rating    Rating?
}

model SlaEvent {
  id          String         @id @default(cuid())
  bookingId   String
  metricType  SlaMetricType
  dueAt       DateTime
  fulfilledAt DateTime?
  breachedAt  DateTime?
  status      SlaEventStatus @default(PENDING)
  metadata    Json?

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([status, dueAt])
}

model Rating {
  id                 String                 @id @default(cuid())
  bookingId          String                 @unique
  userId             String
  clinicId           String
  overallScore       Int
  arrivalScore       Int?
  priceAccuracyScore Int?
  communicationScore Int?
  comment            String?
  isPublished        Boolean                @default(false)
  moderationStatus   RatingModerationStatus @default(PENDING)
  moderationReason   String?
  moderatedAt        DateTime?
  createdAt          DateTime               @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  clinic  Clinic  @relation(fields: [clinicId], references: [id])

  @@index([clinicId, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id            String         @id @default(cuid())
  actorType     AuditActorType
  actorId       String?
  action        AuditAction
  entityType    String
  entityId      String?
  clinicId      String?
  requestId     String?
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  createdAt     DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([clinicId, createdAt])
  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  eventType   String
  aggregateId String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, createdAt])
}

// ─── MVP lean models ────────────────────────────────────────────────────────

enum MvpRequestStatus {
  WAITING
  PRICE_LOCK
  DISPATCHED
  COMPLETED
  DECLINED
}

enum MvpChatActorType {
  USER
  CLINIC
  ADMIN
}

enum MvpOnboardingStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum MvpClinicAccessRole {
  OPERATOR
  ADMIN
}

enum MvpClinicAccessTokenStatus {
  ACTIVE
  REVOKED
}

model MvpClinicAccessToken {
  id         String                       @id @default(cuid())
  clinicId   String
  tokenHash  String                       @unique
  label      String
  role       MvpClinicAccessRole          @default(OPERATOR)
  status     MvpClinicAccessTokenStatus   @default(ACTIVE)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime                     @default(now())
  revokedAt  DateTime?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
  @@index([expiresAt])
}

model MvpRequest {
  id           String           @id @default(cuid())
  userId       String?
  offerId      String
  clinicId     String?
  district     String
  desiredTime  String
  profile      String
  serviceSlug  String           @default("custom")
  serviceLabel String           @default("Другая медицинская услуга")
  servicePrice String           @default("стоимость уточняется")
  status       MvpRequestStatus @default(WAITING)
  priceMin     Int?
  priceMax     Int?
  priceCurrency String          @default("RUB")
  etaMinutes   Int?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  clinic   Clinic?          @relation(fields: [clinicId], references: [id])
  messages MvpChatMessage[]

  @@index([clinicId, status])
  @@index([createdAt])
}

model MvpChatMessage {
  id        String           @id @default(cuid())
  requestId String
  actorType MvpChatActorType
  body      String
  createdAt DateTime         @default(now())

  request MvpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model MvpOnboarding {
  id          String              @id @default(cuid())
  clinicId    String              @unique
  data        Json
  submittedAt DateTime?
  status      MvpOnboardingStatus @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])
}
